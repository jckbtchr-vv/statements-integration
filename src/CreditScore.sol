pragma solidity 0.8.28;

import {CreditDrawing} from "./CreditDrawing.sol";

/// @title Credit Score
/// @notice A Credit's score, 80–800, computed from its seed and payment second alone. The same
///         formula runs on jack.art/credits/rating (script/credit-score.mjs is the reference).
///
///         Five traits: palette (the plates the payment second selects), active bits (inked bits
///         across those plates), occupied cells (distinct raster cells inked, after
///         misregistration), eights in the seed, and registration band. Each trait value carries
///         fixed points, round(-ln(tail) × 1e9), where tail is the share of the sealed edition of
///         122,154 whose value is as rare or rarer; eights count twice. A Credit's rarity is the
///         sum of its points. A fixed 201-point curve through the edition's sorted rarities
///         places it on 80–800, linearly between points.
///
///         Scores are in ten-thousandths (800,000–8,000,000). A rarer Credit never scores lower.
contract CreditScore {
    uint256 internal constant KNOTS = 200;
    // TABLE: 5-byte big-endian entries, in this order.
    uint256 internal constant PALETTE = 0; // 16, by plate mask
    uint256 internal constant ACTIVE = 16; // 257, by active bits
    uint256 internal constant OCCUPIED = 273; // 145, by occupied cells
    uint256 internal constant EIGHTS = 418; // 22, by eights (points already doubled)
    uint256 internal constant REGISTRATION = 440; // 6: Registered, Nudge, Slip, Skew, Drift, Loose
    uint256 internal constant CURVE = 446; // 201 knots, ascending

    // Generated by script/credit-score.mjs from the sealed edition.
    bytes internal constant TABLE = hex"";

    /// @notice The five traits, from the seed and payment second.
    function traitsOf(bytes21 seed, uint64 paidAt)
        public
        pure
        returns (uint256 mask, uint256 active, uint256 occupied, uint256 eights, uint256 band)
    {
        mask = (paidAt % 15) + 1;
        uint256 hash = uint256(sha256(abi.encodePacked(seed)));
        (int8[4] memory dx, int8[4] memory dy) = CreditDrawing.slips(seed);
        uint256[12] memory rows;
        for (uint256 l; l < 4; ++l) {
            if ((mask >> l) & 1 == 0) continue;
            uint256 plate = (hash >> (192 - 64 * l)) & type(uint64).max;
            active += _popcount(plate);
            // Row y of the plate is byte y (x = 0 at the high bit). Placed on the 12 × 12 raster
            // at row y + dy + 2, column x + dx + 2, with column c at bit 11 - c.
            for (uint256 y; y < 8; ++y) {
                uint256 bits = (plate >> (56 - 8 * y)) & 0xff;
                if (bits == 0) continue;
                uint256 row = uint256(int256(y) + dy[l] + 2);
                rows[row] |= bits << uint256(2 - int256(dx[l]));
            }
        }
        for (uint256 r; r < 12; ++r) {
            occupied += _popcount(rows[r]);
        }
        for (uint256 i; i < 21; ++i) {
            if (seed[i] == 0x38) ++eights;
        }
        bytes32 misprint = sha256(abi.encodePacked(seed, "/misprint"));
        if (uint8(misprint[0]) >= 32) {
            band = 0;
        } else {
            uint256 dice = uint8(misprint[1]);
            band = dice < 80 ? 1 : dice < 160 ? 2 : dice < 210 ? 3 : dice < 240 ? 4 : 5;
        }
    }

    /// @notice Sum of the Credit's trait points.
    function rarityOf(bytes21 seed, uint64 paidAt) public pure returns (uint256) {
        (uint256 mask, uint256 active, uint256 occupied, uint256 eights, uint256 band) = traitsOf(seed, paidAt);
        bytes memory t = TABLE;
        return _at(t, PALETTE + mask) + _at(t, ACTIVE + active) + _at(t, OCCUPIED + occupied)
            + _at(t, EIGHTS + eights) + _at(t, REGISTRATION + band);
    }

    /// @notice The Credit's score in ten-thousandths (1,324,012 = 132.4012, Credit #1).
    function scoreOf(bytes21 seed, uint64 paidAt) external pure returns (uint256) {
        return curve(rarityOf(seed, paidAt));
    }

    /// @notice scoreOf from the five traits (StatementArt.inkAndTraits works them out with the ink).
    function scoreOfTraits(uint256 mask, uint256 active, uint256 occupied, uint256 eights, uint256 band)
        external
        pure
        returns (uint256)
    {
        bytes memory t = TABLE;
        uint256 rarity = _at(t, PALETTE + mask) + _at(t, ACTIVE + active) + _at(t, OCCUPIED + occupied)
            + _at(t, EIGHTS + eights) + _at(t, REGISTRATION + band);
        return _curve(t, rarity);
    }

    /// @notice Places a rarity on 800,000–8,000,000, linearly between the edition's knots.
    function curve(uint256 x) public pure returns (uint256) {
        return _curve(TABLE, x);
    }

    function _curve(bytes memory t, uint256 x) private pure returns (uint256) {
        if (x <= _at(t, CURVE)) return 800_000;
        if (x >= _at(t, CURVE + KNOTS)) return 8_000_000;
        uint256 l;
        uint256 h = KNOTS; // largest l with knot[l] <= x
        while (h - l > 1) {
            uint256 m = (l + h) >> 1;
            if (_at(t, CURVE + m) <= x) l = m;
            else h = m;
        }
        uint256 low = _at(t, CURVE + l);
        uint256 d = _at(t, CURVE + l + 1) - low;
        return 800_000 + (36_000 * (l * d + (x - low))) / d;
    }

    function _at(bytes memory t, uint256 i) private pure returns (uint256 v) {
        assembly ("memory-safe") {
            v := shr(216, mload(add(add(t, 32), mul(i, 5))))
        }
    }

    /// @dev Bits set in x, counted in parallel. Every caller passes at most 64 bits.
    function _popcount(uint256 x) private pure returns (uint256) {
        unchecked {
            x -= (x >> 1) & 0x5555555555555555;
            x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333);
            x = (x + (x >> 4)) & 0x0f0f0f0f0f0f0f0f;
            return ((x * 0x0101010101010101) >> 56) & 0xff;
        }
    }
}
